# Model Artifacts & Heavy Data Outputs
# Raw reference metadata (like city profiles) can be tracked, but heavy synthetic generation is excluded
data/generated/*
!data/generated/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/*.pkl
artifacts/*.joblib
artifacts/*.onnx
artifacts/*.pt
!artifacts/.gitkeep
reports/figures/*
!reports/.gitkeep
!notebooks/.gitkeep
!data/raw/.gitkeep

# Temporary / Scratch files
tmp/
temp/
scratch/
